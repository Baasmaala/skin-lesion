*.pt
*.pth
*.ckpt
*.safetensors

# Training logs (regenerable)
results/logs/
results/checkpoints/

# Allow plot images (the whole point of results/plots/ is to be committed)
# (no rule needed -- they're not blocked)

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter
.ipynb_checkpoints/

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db# Confirm the new rules work
